// dql-format: 1

block "Premiums Dataset" {
  domain = "finance"
  type = "custom"
  status = "certified"
  owner = "frank@harbor.example"
  description = "Certified premium Dataset: premium written and earned per policy per month, with region and product."
  tags = ["finance", "premiums", "app-datasets"]

  grain = {
    entities = ["policy_month"]
    keys = ["policy_id", "month"]
    keyEvidence = "proof.premiums"
    timeGrain = "month"
  }

  fields {
    policy_id { role = "key", type = "string" }
    region { role = "dimension", type = "string" }
    product { role = "dimension", type = "string" }
    month { role = "time", type = "timestamp", grains = ["month"], primary = true }
    written_premium { role = "attribute", type = "number" }
    earned_premium { role = "attribute", type = "number" }
  }

  measures {
    written_premium_total { agg = "sum", from = "written_premium", additive = "additive", allowedAggs = ["sum"], format = "currency", currency = "USD" }
    earned_premium_total { agg = "sum", from = "earned_premium", additive = "additive", allowedAggs = ["sum"], format = "currency", currency = "USD" }
  }

  query = """
SELECT
  policy_id,
  region,
  product,
  month,
  written_premium,
  earned_premium
FROM premiums
"""

  visualization {
    chart = "bar"
  }
}
