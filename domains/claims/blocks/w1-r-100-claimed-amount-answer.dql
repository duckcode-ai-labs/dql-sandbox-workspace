// dql-format: 1
// Draft for ZLens Enterprise request R-100, asked by success+dql-live-40569091576-perm-erin@simulator.amazonses.com on 2026-10-27.
// The SQL below is what the AI wrote. Make it right, declare its grain and keys, add a test and mark it certified,
// then press "Submit for review" for a steward to review it.
// Tables it read: harbor.main.adjusters, harbor.main.claims

block "W1 R-100 claimed amount answer" {
  domain = "claims"
  type = "custom"
  status = "certified"
  owner = "success+dql-live-40569091576-perm-cole@simulator.amazonses.com"
  description = "Answers \"Which adjusters handle the most open claims?\". W1 R-100 claimed amount answer. Built by the live check R-100."
  tags = ["request:R-100", "app-source"]
  pattern = "custom"
  entities = ["claim"]
  sourceSystems = ["claims"]
  grain = "one row per group in the question"
  reviewCadence = "monthly"
  llmContext = "Use for questions like \"Which adjusters handle the most open claims?\". live-check-w1 R-100"
  outputs = ["adjuster_id", "adjuster_name", "open_claims"]


  query = """
SELECT 
    "harbor"."main"."adjusters".adjuster_id, 
    "harbor"."main"."adjusters".adjuster_name, 
    COUNT("harbor"."main"."claims".claim_id) AS open_claims
FROM 
    "harbor"."main"."claims"
JOIN 
    "harbor"."main"."adjusters" ON "harbor"."main"."claims".adjuster_id = "harbor"."main"."adjusters".adjuster_id
WHERE 
    "harbor"."main"."claims".status = 'open'
GROUP BY 
    "harbor"."main"."adjusters".adjuster_id, 
    "harbor"."main"."adjusters".adjuster_name
ORDER BY 
    open_claims DESC
LIMIT 10
"""

  tests {
    assert row_count > 0
  }
}
