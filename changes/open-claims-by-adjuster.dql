// dql-format: 1

block "Open claims by adjuster" {
  domain = "claims"
  type = "custom"
  status = "certified"
  owner = "sam@harbor.example"
  description = "Open claims per adjuster, most first. Open means status is open, as in Open claims by region. Built for R-000."
  tags = ["claims", "open-claims", "request:R-000"]

  query = """
SELECT
  a.adjuster_id,
  a.adjuster_name,
  COUNT(DISTINCT c.claim_id) AS open_claims
FROM claims c
JOIN adjusters a ON a.adjuster_id = c.adjuster_id
WHERE c.status = 'open'
GROUP BY a.adjuster_id, a.adjuster_name
ORDER BY open_claims DESC, a.adjuster_id
"""

  visualization {
    chart = "bar"
    x = adjuster_name
    y = open_claims
  }

  tests {
    assert row_count > 0
  }
}
